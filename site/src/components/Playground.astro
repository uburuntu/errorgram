---
import { catalogueVersion } from "../../../js/src/index.ts";
---

<section class="playground" aria-label="Try the error classifier">
  <p class="intro">Paste a Telegram Bot API response to find its condition and extracted facts.</p>
  <p id="playground-privacy" class="hint">Your input stays in this page. It is never uploaded, saved, or added to an issue.</p>
  <form id="playground-form" autocomplete="off" novalidate aria-describedby="playground-privacy">
    <fieldset disabled>
      <legend class="sr-only">Response to classify</legend>
      <label for="playground-response">API response JSON</label>
      <textarea id="playground-response" rows="9" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="playground-response-help playground-error" placeholder={'{ "ok": false, "error_code": 400, "description": "Bad Request: chat not found" }'}></textarea>
      <p id="playground-response-help" class="hint">Paste the JSON response body, up to 32,768 characters. A token or request URL is not needed.</p>
      <label for="playground-method">API method <span class="optional">(optional)</span></label>
      <input id="playground-method" type="text" maxlength="128" placeholder="e.g. sendMessage" spellcheck="false" autocapitalize="off" autocomplete="off" aria-describedby="playground-method-help" />
      <p id="playground-method-help" class="hint">Add the method you called if the result needs more context.</p>
      <p id="playground-error" class="input-error" role="alert" hidden></p>
      <div class="actions">
        <button type="submit" class="primary">Classify response</button>
        <button type="button" id="playground-example">Load example</button>
        <button type="button" id="playground-clear">Clear</button>
      </div>
    </fieldset>
  </form>
  <noscript><p>This form needs JavaScript. The guide below and the complete error reference work without it.</p></noscript>
  <div aria-live="polite" aria-atomic="true">
    <section id="playground-result" class="result" tabindex="-1" aria-labelledby="playground-result-title" hidden>
      <h2 id="playground-result-title">Classification result</h2>
      <p class="status-line">Status <code id="playground-status"></code></p>
      <p id="playground-summary"></p>
      <div id="playground-match" hidden>
        <p>Condition <strong><code id="playground-condition"></code></strong></p>
        <a id="playground-reference">Read this condition’s reference</a>
      </div>
      <div id="playground-candidates" hidden>
        <h3>Candidate conditions</h3>
        <ul id="playground-candidate-list"></ul>
      </div>
      <h3>Extracted facts</h3>
      <pre><code id="playground-facts"></code></pre>
      <p id="playground-report" hidden>Missing a condition? <a href="https://github.com/uburuntu/errorgram/issues/new?template=unknown-error.yml" target="_blank" rel="noopener noreferrer">Open the unknown-error form</a>. The form starts empty; review and redact anything you choose to share publicly.</p>
      <p class="hint">Catalogue <code>{catalogueVersion}</code>. Each record states its evidence. Coverage is incomplete.</p>
    </section>
  </div>
</section>

<script>
  import "../scripts/playground.ts";
</script>

<style>
  .playground { margin-bottom: 2.5rem; }
  .intro { font-size: 1.125rem; color: var(--sl-color-gray-1); }
  .hint { color: var(--sl-color-gray-2); font-size: 0.875rem; line-height: 1.6; margin-block: 0.5rem 1rem; }
  form { margin-block: 1.5rem; }
  fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
  label { display: block; font-weight: 650; margin-block: 1rem 0.5rem; }
  .optional { font-weight: 400; color: var(--sl-color-gray-2); }
  textarea, input { display: block; width: 100%; border: 1px solid var(--sl-color-gray-3); border-radius: 0.4rem; padding: 0.8rem; background: var(--sl-color-black); color: var(--sl-color-white); font: 1rem/1.5 var(--sl-font-mono); }
  textarea { resize: vertical; min-height: 12rem; }
  input { max-width: 26rem; }
  .actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.25rem; }
  button { min-height: 2.75rem; padding: 0.65rem 1rem; border: 1px solid var(--sl-color-gray-3); border-radius: 0.4rem; background: var(--sl-color-gray-6); color: var(--sl-color-white); font: inherit; cursor: pointer; }
  button.primary { background: var(--sl-color-accent-high); border-color: var(--sl-color-accent-high); color: var(--sl-color-accent-low); font-weight: 650; }
  button:hover { filter: brightness(0.93); }
  :is(button, input, textarea, .result):focus-visible { outline: 3px solid var(--sl-color-accent); outline-offset: 3px; }
  .input-error { padding: 0.75rem; border: 1px solid var(--sl-color-gray-3); border-inline-start: 4px solid var(--sl-color-accent); }
  .result { border: 1px solid var(--sl-color-gray-4); border-radius: 0.5rem; padding: 1.25rem; overflow-wrap: anywhere; }
  .result h2 { margin: 0 0 1rem; font-size: 1.3rem; }
  .result h3 { margin: 1.25rem 0 0.5rem; font-size: 1rem; }
  .result p { margin-block: 0.8rem; }
  .result a { color: var(--sl-color-text-accent); text-underline-offset: 0.2em; }
  .result code { font-family: var(--sl-font-mono); font-size: 0.9em; }
  .status-line code { margin-inline-start: 0.5rem; font-weight: 650; }
  pre { white-space: pre-wrap; overflow-wrap: anywhere; background: var(--sl-color-gray-6); border-radius: 0.35rem; padding: 0.8rem; }
  ul { padding-inline-start: 1.5rem; }
  [hidden] { display: none !important; }
</style>
